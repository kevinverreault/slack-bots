# Copy to infra/.env (untracked) for local `cdk` runs. CI uses GitHub repository variables instead.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ca-central-1
AGENT_SLACK_USER_ID=U0123456789
BUDGET_ALERT_EMAIL=you@example.com
# Only if your AWS account already has a GitHub OIDC provider:
# GITHUB_OIDC_PROVIDER_ARN=arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com
# GitHub's OIDC subject prefix for this repo; the setup wizard fills it in. Find it with:
#   gh api repos/{owner}/{repo}/actions/oidc/customization/sub --jq .sub_claim_prefix
# GITHUB_OIDC_SUB_PREFIX=repo:owner@123/slack-bots@456
